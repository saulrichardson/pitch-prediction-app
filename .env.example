NEXT_PUBLIC_SITE_URL=https://baseball.saulrichardson.io
NEXT_PUBLIC_GA_MEASUREMENT_ID=
SESSION_SECRET=replace-with-a-long-random-secret
STORAGE_MODE=memory

# Local web preview of a prepared real-model edition (absolute path).
# Filesystem edition loading is disabled in production.
REPLAY_EDITION_PATH=

# Operator preparation only. The web application does not invoke the model.
MODEL_BACKEND=http
MODEL_BASE_URL=http://127.0.0.1:8000
MODEL_API_KEY=
# For an immutable AWS model version, set MODEL_BACKEND=lambda and this target.
MODEL_LAMBDA_FUNCTION_NAME=

# Durable publication / web storage. Select STORAGE_MODE=dynamodb or postgres.
DYNAMODB_TABLE_NAME=pitch-sequence-serverless-state
DATABASE_URL=
CLOUDFRONT_ALLOWED_COUNTRIES=US
